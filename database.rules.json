{
  "rules": {
    "rooms": {
      "$roomId": {
        ".read": true,
        ".write": "auth != null",
        "chat": {
          "$messageId": {
            ".validate": "newData.hasChildren(['player', 'message']) && newData.child('message').isString() && newData.child('message').val().length <= 500"
          }
        }
      }
    },
    "quickMatchQueue": {
      ".read": true,
      ".write": "auth != null",
      ".indexOn": ["joinedAt"]
    },
    "globalChatMessages": {
      ".read": true,
      ".write": "auth != null",
      ".indexOn": ["timestamp"],
      "$messageId": {
        ".validate": "newData.hasChildren(['text', 'userId']) && newData.child('text').isString() && newData.child('text').val().length <= 500"
      }
    },
    "onlineUsers": {
      ".read": true,
      "guests": {
        "$sessionId": {
          ".write": "true",
          ".validate": "newData.hasChildren(['sessionId', 'lastSeen']) && newData.child('sessionId').isString() && newData.child('sessionId').val().length <= 64 && newData.child('lastSeen').isNumber()"
        }
      },
      "$userId": {
        ".write": "auth != null && auth.uid == $userId",
        "$sessionId": {
          ".validate": "newData.hasChildren(['sessionId', 'lastSeen']) && newData.child('lastSeen').isNumber()"
        }
      }
    },
    ".read": false,
    ".write": false
  }
}
