{
  "rules": {
    "rooms": {
      "$roomId": {
        ".read": true,
        ".write": "auth != null",
        "host": {
          ".read": true,
          ".write": "auth != null"
        },
        "status": {
          ".read": true,
          ".write": "auth != null"
        },
        "gridSize": {
          ".read": true,
          ".write": "auth != null"
        },
        "maxPlayers": {
          ".read": true,
          ".write": "auth != null"
        },
        "createdAt": {
          ".read": true,
          ".write": "auth != null"
        },
        "players": {
          ".read": true,
          ".write": "auth != null",
          "$playerId": {
            ".read": true,
            ".write": "auth != null"
          }
        },
        "gameState": {
          ".read": true,
          ".write": "auth != null",
          "lines": {
            ".read": true,
            ".write": "auth != null"
          },
          "lineOwners": {
            ".read": true,
            ".write": "auth != null"
          },
          "boxes": {
            ".read": true,
            ".write": "auth != null"
          },
          "currentPlayer": {
            ".read": true,
            ".write": "auth != null"
          },
          "players": {
            ".read": true,
            ".write": "auth != null"
          },
          "gameState": {
            ".read": true,
            ".write": "auth != null"
          },
          "isRematch": {
            ".read": true,
            ".write": "auth != null"
          },
          "reset": {
            ".read": true,
            ".write": "auth != null"
          }
        },
        "chat": {
          ".read": true,
          ".write": "auth != null",
          "$messageId": {
            ".read": true,
            ".write": "auth != null"
          }
        },
        "rematchRequests": {
          ".read": true,
          ".write": "auth != null",
          "$playerId": {
            ".read": true,
            ".write": "auth != null"
          }
        },
        "rematchState": {
          ".read": true,
          ".write": "auth != null",
          "active": {
            ".read": true,
            ".write": "auth != null"
          },
          "startTime": {
            ".read": true,
            ".write": "auth != null"
          },
          "hostId": {
            ".read": true,
            ".write": "auth != null"
          },
          "timeout": {
            ".read": true,
            ".write": "auth != null"
          },
          "players": {
            ".read": true,
            ".write": "auth != null",
            "$playerId": {
              ".read": true,
              ".write": "auth != null"
            }
          }
        },
        "rematchReady": {
          ".read": true,
          ".write": "auth != null"
        },
        "gameEndedAt": {
          ".read": true,
          ".write": "auth != null"
        }
      }
    },
    "quickMatchQueue": {
      ".read": true,
      ".write": "auth != null",
      ".indexOn": [
        "timestamp",
        "gridSize"
      ],
      "$playerId": {
        ".read": true,
        ".write": "auth != null"
      }
    },
    "matchmakingPool": {
      ".read": true,
      ".write": "auth != null",
      ".indexOn": [
        "timestamp",
        "gridSize"
      ],
      "$playerId": {
        ".read": true,
        ".write": "auth != null"
      }
    },
    "globalChat": {
      ".read": true,
      ".write": "auth != null",
      ".indexOn": [
        "timestamp"
      ],
      "$messageId": {
        ".read": true,
        ".write": "auth != null"
      }
    },
    "globalChatMessages": {
      ".read": true,
      ".write": "auth != null",
      ".indexOn": [
        "timestamp"
      ],
      "$messageId": {
        ".read": true,
        ".write": "auth != null"
      }
    },
    "onlineUsers": {
      ".read": true,
      ".write": "auth != null",
      "$userId": {
        ".read": true,
        ".write": "auth != null"
      }
    },
    ".read": false,
    ".write": false
  }
}